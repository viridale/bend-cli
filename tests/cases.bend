# Purpose: end-to-end cases as data: an app's environment and argv, with
# the exact exit code, stdout and stderr every mode must produce (§13).
# Expected output: ALL PROOFS CHECK.
# Run: bend tests/cases.bend --check-only

import Base

# env holds NAME=value words for env(1); argv is what the app must see.
type Case is Data:
  Case{name: String, env: List<&2, String>, argv: List<&2, String>,
    code: U32, out: String, err: String}

# lines, each ending in "\n".
def page(lines: List<&2, String>) -> String:
  String.concat([String.join(lines, "\n"), "\n"])

# pkg (main.bend) in every mode, after the launcher's "--".
def cases() -> List<&2, Case>:
  [
  Case{"version", [], ["--version"], 0,
    "pkg 0.1.0\n",
    ""},
  Case{"list", [], ["list"], 0,
    "list all=false format=text verbose=0\n",
    ""},
  Case{"remove alias with globals", [], ["-vv", "-C", "/tmp", "rm", "a"], 0,
    "remove names=a verbose=2 dir=/tmp\n",
    ""},
  Case{"registry default", [], ["add", "x"], 0,
    "add dev=false registry=https://registry.example names=x verbose=0\n",
    ""},
  Case{"registry from env",
    ["PKG_REGISTRY=https://r.example"], ["add", "-D", "x"], 0,
    "add dev=true registry=https://r.example names=x verbose=0\n",
    ""},
  Case{"registry option beats env",
    ["PKG_REGISTRY=https://r.example"],
    ["add", "--registry", "https://o.example", "x"], 0,
    "add dev=false registry=https://o.example names=x verbose=0\n",
    ""},
  Case{"script args after --", [], ["run", "s", "--", "-x"], 0,
    "run script=s args=-x verbose=0\n",
    ""},
  Case{"no arguments", [], [], 2,
    "",
    page([
      "A package manager (demo)",
      "",
      "Usage: pkg [OPTIONS] <COMMAND>",
      "",
      "Commands:",
      "  add                 Add packages",
      "  remove              Remove packages [aliases: rm]",
      "  list                List installed packages",
      "  run                 Run a package script",
      "  completions         Print a shell completion script",
      "  help                Print this message or the help of the given subcommand(s)",
      "",
      "Options:",
      "      --color <WHEN>  When to use color [default: auto] [possible values: auto,",
      "                      always, never]",
      "  -v, --verbose...    More output; repeat for more",
      "  -C <DIR>            Run as if started in DIR",
      "  -h, --help          Print help",
      "  -V, --version       Print version",
    ])},
  Case{"unknown option", [], ["--bogus"], 2,
    "",
    page([
      "error: unexpected argument '--bogus' found",
      "",
      "Usage: pkg [OPTIONS] <COMMAND>",
      "",
      "For more information, try '--help'.",
    ])},
  Case{"invalid choice", [], ["list", "--format", "xml"], 2,
    "",
    page([
      "error: invalid value 'xml' for '--format <FMT>': expected one of 'text', 'json'",
      "",
      "Usage: pkg list [OPTIONS]",
      "",
      "For more information, try '--help'.",
    ])},
  Case{"help at width 80", [], ["list", "--help"], 0,
    page([
      "List installed packages",
      "",
      "Usage: pkg list [OPTIONS]",
      "",
      "Options:",
      "  -a, --all           Include transitive packages",
      "      --format <FMT>  Output format [default: text] [possible values: text,",
      "                      json]",
      "      --color <WHEN>  When to use color [default: auto] [possible values: auto,",
      "                      always, never]",
      "  -v, --verbose...    More output; repeat for more",
      "  -C <DIR>            Run as if started in DIR",
      "  -h, --help          Print help",
    ]),
    ""},
  Case{"help at COLUMNS=40", ["COLUMNS=40"], ["list", "--help"], 0,
    page([
      "List installed packages",
      "",
      "Usage: pkg list [OPTIONS]",
      "",
      "Options:",
      "  -a, --all   Include transitive",
      "              packages",
      "      --format <FMT>",
      "              Output format [default:",
      "              text] [possible values:",
      "              text, json]",
      "      --color <WHEN>",
      "              When to use color",
      "              [default: auto] [possible",
      "              values: auto, always,",
      "              never]",
      "  -v, --verbose...",
      "              More output; repeat for",
      "              more",
      "  -C <DIR>    Run as if started in DIR",
      "  -h, --help  Print help",
    ]),
    ""},
  Case{"COLUMNS=0 keeps 80", ["COLUMNS=0"], ["list", "--help"], 0,
    page([
      "List installed packages",
      "",
      "Usage: pkg list [OPTIONS]",
      "",
      "Options:",
      "  -a, --all           Include transitive packages",
      "      --format <FMT>  Output format [default: text] [possible values: text,",
      "                      json]",
      "      --color <WHEN>  When to use color [default: auto] [possible values: auto,",
      "                      always, never]",
      "  -v, --verbose...    More output; repeat for more",
      "  -C <DIR>            Run as if started in DIR",
      "  -h, --help          Print help",
    ]),
    ""},
  Case{"COLUMNS past U32 sets width 100",
    ["COLUMNS=4294967296"], ["list", "--help"], 0,
    page([
      "List installed packages",
      "",
      "Usage: pkg list [OPTIONS]",
      "",
      "Options:",
      "  -a, --all           Include transitive packages",
      "      --format <FMT>  Output format [default: text] [possible values: text, json]",
      "      --color <WHEN>  When to use color [default: auto] [possible values: auto, always, never]",
      "  -v, --verbose...    More output; repeat for more",
      "  -C <DIR>            Run as if started in DIR",
      "  -h, --help          Print help",
    ]),
    ""},
  Case{"COLUMNS past 2^48-1 keeps 80",
    ["COLUMNS=281474976710656"], ["list", "--help"], 0,
    page([
      "List installed packages",
      "",
      "Usage: pkg list [OPTIONS]",
      "",
      "Options:",
      "  -a, --all           Include transitive packages",
      "      --format <FMT>  Output format [default: text] [possible values: text,",
      "                      json]",
      "      --color <WHEN>  When to use color [default: auto] [possible values: auto,",
      "                      always, never]",
      "  -v, --verbose...    More output; repeat for more",
      "  -C <DIR>            Run as if started in DIR",
      "  -h, --help          Print help",
    ]),
    ""},
  Case{"help subcommand", [], ["help", "run"], 0,
    page([
      "Run a package script",
      "",
      "Usage: pkg run [OPTIONS] <SCRIPT> [ARGS]...",
      "",
      "Arguments:",
      "  <SCRIPT>            Script name",
      "  [ARGS]...           Arguments for the script",
      "",
      "Options:",
      "      --color <WHEN>  When to use color [default: auto] [possible values: auto,",
      "                      always, never]",
      "  -v, --verbose...    More output; repeat for more",
      "  -C <DIR>            Run as if started in DIR",
      "  -h, --help          Print help",
    ]),
    ""},
  Case{"CLICOLOR_FORCE colors errors", ["CLICOLOR_FORCE=1"], ["--bogus"], 2,
    "",
    page([
      "\u{1B}[1;31merror:\u{1B}[0m unexpected argument '\u{1B}[33m--bogus\u{1B}[0m' found",
      "",
      "\u{1B}[1;4mUsage:\u{1B}[0m \u{1B}[1mpkg\u{1B}[0m [OPTIONS] <COMMAND>",
      "",
      "For more information, try '\u{1B}[1m--help\u{1B}[0m'.",
    ])},
  Case{"NO_COLOR beats CLICOLOR_FORCE",
    ["NO_COLOR=1", "CLICOLOR_FORCE=1"], ["--bogus"], 2,
    "",
    page([
      "error: unexpected argument '--bogus' found",
      "",
      "Usage: pkg [OPTIONS] <COMMAND>",
      "",
      "For more information, try '--help'.",
    ])},
  Case{"--color=always colors help", [], ["--color=always", "remove", "-h"], 0,
    page([
      "Remove packages",
      "",
      "\u{1B}[1;4mUsage:\u{1B}[0m \u{1B}[1mpkg remove\u{1B}[0m [OPTIONS] <NAME>...",
      "",
      "\u{1B}[1;4mArguments:\u{1B}[0m",
      "  <NAME>...           Packages to remove",
      "",
      "\u{1B}[1;4mOptions:\u{1B}[0m",
      "      \u{1B}[1m--color\u{1B}[0m <WHEN>  When to use color [default: auto] [possible values: auto,",
      "                      always, never]",
      "  \u{1B}[1m-v\u{1B}[0m, \u{1B}[1m--verbose\u{1B}[0m...    More output; repeat for more",
      "  \u{1B}[1m-C\u{1B}[0m <DIR>            Run as if started in DIR",
      "  \u{1B}[1m-h\u{1B}[0m, \u{1B}[1m--help\u{1B}[0m          Print help",
    ]),
    ""},
  Case{"act exits 1", [], ["run", "exit", "1"], 1,
    "run script=exit args=1 verbose=0\n",
    ""},
  Case{"act exits 255", [], ["run", "exit", "255"], 255,
    "run script=exit args=255 verbose=0\n",
    ""},
  Case{"act exits 256", [], ["run", "exit", "256"], 70,
    "run script=exit args=256 verbose=0\n",
    "bug: exit code 256 is out of range 0..255\n"},
  ]

# pkg in the native and js modes without the launcher's "--", so the
# runtime acts on the case's own argv. A failing canary means U1 landed:
# delete the K1 and K2 workarounds and their docs (§13).
def canaries() -> List<&2, Case>:
  [
  Case{"K1 runtime takes --", [], ["run", "s", "--", "-x"], 2,
    "",
    page([
      "error: unexpected argument '-x' found",
      "",
      "  tip: to pass '-x' as a value, use '-- -x'",
      "",
      "Usage: pkg run [OPTIONS] <SCRIPT> [ARGS]...",
      "",
      "For more information, try '--help'.",
    ])},
  Case{"K2 runtime takes --threads", [], ["run", "s", "--threads", "1"], 0,
    "run script=s args= verbose=0\n",
    ""},
  ]

# tests/f32.bend in every mode: a given as_f32 value end to end (K8).
def f32_cases() -> List<&2, Case>:
  [
  Case{"f32 reads a decimal", [], ["--rate", "1.5"], 0,
    "1.5 1069547520\n",
    ""},
  Case{"f32 reads an exponent", [], ["--rate", "-2.5e3"], 0,
    "-2500 3306962944\n",
    ""},
  Case{"f32 reads a leading point", [], ["--rate", ".5"], 0,
    "0.5 1056964608\n",
    ""},
  Case{"f32 rounds to nearest", [], ["--rate", "0.1"], 0,
    "0.1 1036831949\n",
    ""},
  Case{"f32 overflows to inf", [], ["--rate", "1e40"], 0,
    "inf 2139095040\n",
    ""},
  Case{"f32 refuses nan", [], ["--rate", "nan"], 2,
    "",
    page([
      "error: invalid value 'nan' for '--rate <R>': expected a decimal number",
      "",
      "Usage: f32 [OPTIONS]",
      "",
      "For more information, try '--help'.",
    ])},
  Case{"f32 refuses a bare exponent", [], ["--rate", "1e"], 2,
    "",
    page([
      "error: invalid value '1e' for '--rate <R>': expected a decimal number",
      "",
      "Usage: f32 [OPTIONS]",
      "",
      "For more information, try '--help'.",
    ])},
  ]
